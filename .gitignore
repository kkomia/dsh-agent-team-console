# Dependencies
# This package has no runtime dependencies; node_modules is ignored so a local
# experiment cannot leak into the repository.
node_modules/

# Logs
*.log
*.tgz
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Test output
coverage/

# Local environment and secrets
.env
.env.*
!.env.example

# Local scratch research (specs, QA reports, logs); never published
.research/

# OS metadata
.DS_Store
Thumbs.db
Desktop.ini

# Editors and IDEs
.idea/
.vscode/
*.swp
*.swo
*~
